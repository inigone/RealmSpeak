\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs24\lang1033\loch\fs24\lang1033
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs32\lang1033\loch\fs32\lang1033 {\rtlch \ltrch\loch\f0\fs32\lang1033\i0\b0 The guilds are a new type of dwelling on the board.  They are initially placed as chits, and appear when revealed, much like the two campfires.  Once revealed, they stay face up for the remainder of the game (except for the Thieves' Guild which must be discovered in the same manner as treasure sites.)  They are placed in a random clearing that connects back to the Borderland, so they are guaranteed to be accessible.}
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs24\lang1033\loch\fs24\lang1033
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs32\lang1033\loch\fs32\lang1033 {\rtlch \ltrch\loch\f0\fs32\lang1033\i0\b0 All the guilds allow TRADE, so a character can buy/sell as if they were interacting with a native leader.  At the start of the game, each guild receives items to trade according to each guild's setup sheet box.  To non-guild members, including those who have not yet completed the join requirement, the relationship with any character is UNFRIENDLY, but for members of the guild, this relationship improves as you advance through the ranks:}
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs24\lang1033\loch\fs24\lang1033
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs28\lang1033\loch\fs28\lang1033 {\rtlch \ltrch\loch\f7\fs28\lang1033\i0\b0   LEVEL      TITLE        RELATIONSHIP TO GUILD     HIDDEN AT GUILD}
\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs28\lang1033\loch\fs28\lang1033 {\rtlch \ltrch\loch\f7\fs28\lang1033\i0\b0   -----    ----------   ---------------------     ---------------}
