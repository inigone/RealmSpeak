\par \pard\plain \ltrpar\s1\ql\rtlch\afs24\lang255\ltrch\dbch\langfe255\hich\fs28\lang1033\loch\fs28\lang1033 {\rtlch \ltrch\loch\f7\fs28\lang1033\i0\b0     3        Master             Ally                    Yes}
